generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Employee {
  id                    String    @id @default(cuid())
  name                  String
  email                 String    @unique
  passwordHash          String
  role                  Role      @default(EMPLOYEE)
  title                 String?
  phone                 String?
  startDate             DateTime?
  photoUrl              String?
  isActive              Boolean   @default(true)
  // Admins only: whether this person is emailed when staff submit things. Lets a
  // shared or unattended admin login exist without generating mail nobody reads.
  receivesNotifications Boolean   @default(true)
  defaultPeriodStartDay Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  timesheets          TimesheetWeek[]
  timesheetReviews    TimesheetWeek[]  @relation("TimesheetReviewer")
  leaveRequests       LeaveRequest[]
  leaveReviews        LeaveRequest[]   @relation("LeaveReviewer")
  leaveBalances       LeaveBalance[]
  ptoOverrides        PtoOverride[]
  expenseReports      ExpenseReport[]
  expenseReviews      ExpenseReport[]  @relation("ExpenseReviewer")
  reportPeriods       ReportPeriod[]
  reportPeriodReviews ReportPeriod[]   @relation("PeriodReviewer")
  passwordResetTokens PasswordResetToken[]
  generalRequests       GeneralRequest[]
  generalRequestReviews GeneralRequest[] @relation("GeneralRequestReviewer")
  requestNotes          RequestNote[]
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  token      String   @unique
  employeeId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  EMPLOYEE
}

model Project {
  id         String        @id @default(cuid())
  name       String
  clientName String?
  code       String?       @unique
  status     ProjectStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  entries      TimesheetEntry[]
  expenseItems ExpenseItem[]
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
}

model TimesheetWeek {
  id             String          @id @default(cuid())
  employeeId     String
  weekStartDate  DateTime        // Sunday of the week (normalized to 00:00:00 UTC); weeks created before the Sun-start change use Monday
  reportPeriodId String?
  status         TimesheetStatus @default(DRAFT)
  reviewedById   String?
  reviewComment  String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id])
  reviewer     Employee?     @relation("TimesheetReviewer", fields: [reviewedById], references: [id])
  reportPeriod ReportPeriod? @relation(fields: [reportPeriodId], references: [id])
  entries      TimesheetEntry[]

  @@unique([employeeId, weekStartDate])
}

model ReportPeriod {
  id            String          @id @default(cuid())
  employeeId    String
  startDate     DateTime
  endDate       DateTime
  status        TimesheetStatus @default(DRAFT)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewComment String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  rowOrder  Json?

  employee Employee        @relation(fields: [employeeId], references: [id])
  reviewer Employee?       @relation("PeriodReviewer", fields: [reviewedById], references: [id])
  weeks    TimesheetWeek[]
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

model TimesheetEntry {
  id              String   @id @default(cuid())
  timesheetWeekId String
  projectId       String
  phase           String   @default("")
  date            DateTime // specific calendar day (normalized to 00:00:00 UTC)
  hours           Float    @default(0)
  absenceCode     String?  // H, V, S, C, B, R, H/D
  notes           String?

  timesheetWeek TimesheetWeek @relation(fields: [timesheetWeekId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id])

  @@unique([timesheetWeekId, projectId, phase, date])
}

model LeaveRequest {
  id            String      @id @default(cuid())
  employeeId    String
  type          LeaveType
  startDate     DateTime
  endDate       DateTime
  status        LeaveStatus @default(PENDING)
  reviewedById  String?
  reviewComment String?
  createdAt     DateTime    @default(now())
  reviewedAt    DateTime?
  calendarInviteUid String?

  employee Employee         @relation(fields: [employeeId], references: [id])
  reviewer Employee?        @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  days     LeaveRequestDay[]
  workedDays LeaveWorkedDay[]
}

/// A note on an approved request: the employee reported working one of its days after all.
/// The approved days themselves are never edited; a day noted here just stops counting
/// against the balance.
model LeaveWorkedDay {
  id             String   @id @default(cuid())
  leaveRequestId String
  date           DateTime // the approved day that was worked (normalized to 00:00:00 UTC)
  createdAt      DateTime @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, date])
}

model LeaveRequestDay {
  id             String       @id @default(cuid())
  leaveRequestId String
  date           DateTime
  type           LeaveType    @default(VACATION)
  halfDay        Boolean      @default(false)
  halfDayPeriod  HalfDayPeriod?
  reason         String?

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@index([leaveRequestId])
}

enum LeaveType {
  VACATION
  SICK
  PERSONAL
  OTHER
  COMP_DAY
  MIXED
}

/// Which half of the office day (9:30–18:30) a half-day leave covers. Null on full days and on
/// half days submitted before this choice existed.
enum HalfDayPeriod {
  MORNING
  AFTERNOON
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

/// An admin's manual Vacation/Sick numbers for one work year (start-date anniversary to
/// anniversary). A null field means "automatic": total from the OLI policy formula, used from
/// approved PTO requests in that work year. A set field wins over the automatic value.
model PtoOverride {
  id         String    @id @default(cuid())
  employeeId String
  cycleStart DateTime  // first day of the work year (normalized to 00:00:00 UTC)
  type       LeaveType // VACATION or SICK
  totalDays  Float?
  usedDays   Float?
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, cycleStart, type])
}

model LeaveBalance {
  id         String    @id @default(cuid())
  employeeId String
  year       Int
  type       LeaveType
  totalDays  Float
  usedDays   Float     @default(0)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, year, type])
}

model ExpenseReport {
  id            String        @id @default(cuid())
  employeeId    String
  month         Int
  year          Int
  status        ExpenseStatus @default(DRAFT)
  advanceAmount Float         @default(0)
  notes         String?
  reviewedById  String?
  reviewComment String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  employee  Employee          @relation(fields: [employeeId], references: [id])
  reviewer  Employee?         @relation("ExpenseReviewer", fields: [reviewedById], references: [id])
  items     ExpenseItem[]
  documents ExpenseDocument[]

  @@unique([employeeId, month, year])
}

model ExpenseItem {
  id               String          @id @default(cuid())
  expenseReportId  String
  projectId        String
  date             DateTime
  category         ExpenseCategory
  otherDescription String?
  description      String
  amount           Float
  order            Int             @default(0)

  expenseReport ExpenseReport @relation(fields: [expenseReportId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id])
}

model ExpenseDocument {
  id              String   @id @default(cuid())
  expenseReportId String
  fileName        String
  fileUrl         String
  fileSize        Int?
  mimeType        String?
  uploadedAt      DateTime @default(now())

  expenseReport ExpenseReport @relation(fields: [expenseReportId], references: [id], onDelete: Cascade)
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum ExpenseCategory {
  TRANSPORTATION
  MEALS
  MEALS_USA
  MEALS_CHINA
  ACCOMMODATION
  OTHER
}

model GeneralRequest {
  id            String               @id @default(cuid())
  employeeId    String
  subject       String
  note          String
  status        GeneralRequestStatus @default(PENDING)
  reviewedById  String?
  reviewComment String?
  createdAt     DateTime             @default(now())
  reviewedAt    DateTime?
  notesClosed   Boolean              @default(false)

  employee Employee      @relation(fields: [employeeId], references: [id])
  reviewer Employee?     @relation("GeneralRequestReviewer", fields: [reviewedById], references: [id])
  notes    RequestNote[]
}

enum GeneralRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RequestNote {
  id               String   @id @default(cuid())
  generalRequestId String
  authorId         String
  body             String
  createdAt        DateTime @default(now())

  generalRequest GeneralRequest @relation(fields: [generalRequestId], references: [id], onDelete: Cascade)
  author         Employee       @relation(fields: [authorId], references: [id])

  @@index([generalRequestId])
}
